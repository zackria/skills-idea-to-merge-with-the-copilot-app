---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
// Pure helpers (URL normalising, slugs, storage parsing) live in
// src/lib/bookmarks.ts so they can be unit tested without a browser.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p id="form-message" class="message" role="status" aria-live="polite"></p>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p class="hint" id="storage-warning">Heads up: bookmarks are stored only in this browser on this device. Clearing site data, private windows, or another browser will not have them — use <strong>Export</strong> to back up.</p>

<p id="lost-warning" class="message" role="alert" hidden></p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <div>
    <button id="export" type="button" class="clear">Export</button>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>
</div>

<div id="search-wrap" class="field" hidden>
  <label for="search">Search bookmarks</label>
  <input id="search" type="search" autocomplete="off" spellcheck="false" placeholder="Filter by URL or mona- slug" />
</div>

<p id="no-matches" class="empty" role="status" hidden>No matches for your search.</p>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only (never during the static
  // build), so localStorage is safe to touch here and nowhere else.
  import {
    STORAGE_KEY,
    COUNT_KEY,
    filterBookmarks,
    isStoreUnexpectedlyEmpty,
    SEPARATOR,
    generateSlug,
    normalizeUrl,
    parseBookmarks,
    serializeBookmarks,
    type Bookmark,
  } from '../lib/bookmarks';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const input = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');
  const message = document.getElementById('form-message');
  const search = document.getElementById('search') as HTMLInputElement | null;
  const searchWrap = document.getElementById('search-wrap');
  const noMatches = document.getElementById('no-matches');
  const exportBtn = document.getElementById('export');
  const lostWarning = document.getElementById('lost-warning');

  let bookmarks: Bookmark[] = [];

  function load(): Bookmark[] {
    try {
      return parseBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function save(): void {
    try {
      localStorage.setItem(STORAGE_KEY, serializeBookmarks(bookmarks));
      localStorage.setItem(COUNT_KEY, String(bookmarks.length));
    } catch {
      showMessage('Could not save to browser storage; this bookmark will not persist.');
    }
  }

  function showMessage(text: string): void {
    if (message) message.textContent = text;
  }

  function render(): void {
    if (!list) return;
    const visible = filterBookmarks(bookmarks, search?.value ?? '');
    list.replaceChildren(
      ...visible.map((bookmark) => {
        const li = document.createElement('li');
        li.className = 'bookmark';

        const link = document.createElement('a');
        link.className = 'url';
        link.href = bookmark.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = bookmark.url;

        const sep = document.createElement('span');
        sep.className = 'sep';
        sep.textContent = SEPARATOR;

        const slug = document.createElement('span');
        slug.className = 'slug';
        slug.textContent = bookmark.slug;

        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'copy';
        copy.textContent = 'Copy';
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(bookmark.slug);
            copy.textContent = 'Copied!';
          } catch {
            copy.textContent = 'Copy failed';
          }
          setTimeout(() => (copy.textContent = 'Copy'), 1500);
        });

        li.append(link, sep, slug, copy);
        return li;
      }),
    );
    const hasItems = bookmarks.length > 0;
    if (emptyState) emptyState.hidden = hasItems;
    if (listHeader) listHeader.hidden = !hasItems;
    if (searchWrap) searchWrap.hidden = !hasItems;
    if (noMatches) noMatches.hidden = !hasItems || visible.length > 0;
  }

  function add(raw: string): void {
    const url = normalizeUrl(raw);
    if (!url) {
      showMessage('Please enter a valid web address, like example.com.');
      return;
    }
    const existing = bookmarks.find((b) => b.url === url);
    if (existing) {
      showMessage(`Already saved as ${existing.slug}.`);
      return;
    }
    const slug = generateSlug(bookmarks.map((b) => b.slug));
    bookmarks = [{ url, slug }, ...bookmarks];
    save();
    render();
    showMessage('');
    if (input) input.value = '';
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // keep this FIRST — stops the page from reloading
    try {
      add(input?.value ?? '');
    } catch {
      showMessage('Something went wrong. Please try again.');
    }
  });

  clearAll?.addEventListener('click', () => {
    if (!confirm('Remove all saved bookmarks?')) return;
    bookmarks = [];
    try {
      localStorage.removeItem(STORAGE_KEY);
      localStorage.removeItem(COUNT_KEY);
    } catch {
      /* storage unavailable; the in-memory list is already cleared */
    }
    render();
  });

  search?.addEventListener('input', render);

  exportBtn?.addEventListener('click', () => {
    const blob = new Blob([serializeBookmarks(bookmarks)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'mona-bookmarks.json';
    a.click();
    URL.revokeObjectURL(a.href);
  });

  bookmarks = load();
  try {
    if (lostWarning && isStoreUnexpectedlyEmpty(localStorage.getItem(COUNT_KEY), bookmarks.length)) {
      lostWarning.textContent =
        'Your saved bookmarks are missing — browser storage may have been cleared.';
      lostWarning.hidden = false;
      localStorage.removeItem(COUNT_KEY);
    }
  } catch {
    /* storage unavailable */
  }
  render();
</script>
