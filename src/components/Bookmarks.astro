---
---
<section aria-labelledby="bookmarks-title">
  <form id="add-bookmark">
    <div class="field">
      <label for="url">Website address</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        placeholder="example.com"
        aria-describedby="url-hint form-message"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>
  <p id="url-hint" class="hint">Enter a web address with or without https://.</p>
  <p id="form-message" class="message" role="status" aria-live="polite"></p>

  <div id="list-header" hidden>
    <h2 id="bookmarks-title" class="list-title">Saved bookmarks</h2>
    <button id="clear-all" class="clear" type="button">Clear all</button>
  </div>
  <p id="empty-state" class="empty">No bookmarks yet. Add a link above to get started.</p>
  <ul id="bookmark-list" aria-label="Saved bookmarks"></ul>
</section>

<script>
  import {
    STORAGE_KEY,
    SEPARATOR,
    generateSlug,
    normalizeUrl,
    parseBookmarks,
    serializeBookmarks,
    type Bookmark,
  } from '../lib/bookmarks';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const input = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');
  const message = document.getElementById('form-message');

  let bookmarks: Bookmark[] = [];

  function load(): Bookmark[] {
    try {
      return parseBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function save(): void {
    try {
      localStorage.setItem(STORAGE_KEY, serializeBookmarks(bookmarks));
    } catch {
      showMessage('Could not save to browser storage; this bookmark will not persist.');
    }
  }

  function showMessage(text: string): void {
    if (message) message.textContent = text;
  }

  function render(): void {
    if (!list) return;
    list.replaceChildren(
      ...bookmarks.map((bookmark) => {
        const li = document.createElement('li');
        li.className = 'bookmark';

        const link = document.createElement('a');
        link.className = 'url';
        link.href = bookmark.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = bookmark.url;

        const separator = document.createElement('span');
        separator.className = 'sep';
        separator.textContent = SEPARATOR;

        const slug = document.createElement('span');
        slug.className = 'slug';
        slug.textContent = bookmark.slug;

        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'copy';
        copy.textContent = 'Copy';
        copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(bookmark.slug);
            copy.textContent = 'Copied!';
          } catch {
            copy.textContent = 'Copy failed';
          }
          setTimeout(() => (copy.textContent = 'Copy'), 1500);
        });

        li.append(link, separator, slug, copy);
        return li;
      }),
    );
    const hasItems = bookmarks.length > 0;
    if (emptyState) emptyState.hidden = hasItems;
    if (listHeader) listHeader.hidden = !hasItems;
  }

  function add(raw: string): void {
    const url = normalizeUrl(raw);
    if (!url) {
      showMessage('Please enter a valid web address, like example.com.');
      return;
    }
    const existing = bookmarks.find((bookmark) => bookmark.url === url);
    if (existing) {
      showMessage(`Already saved as ${existing.slug}.`);
      return;
    }
    const slug = generateSlug(bookmarks.map((bookmark) => bookmark.slug));
    bookmarks = [{ url, slug }, ...bookmarks];
    showMessage('');
    save();
    render();
    if (input) input.value = '';
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      add(input?.value ?? '');
    } catch {
      showMessage('Something went wrong. Please try again.');
    }
  });

  clearAll?.addEventListener('click', () => {
    if (!confirm('Remove all saved bookmarks?')) return;
    bookmarks = [];
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      /* storage unavailable; the in-memory list is already cleared */
    }
    showMessage('');
    render();
  });

  bookmarks = load();
  render();
</script>
